# --- Railway: set these as service Variables (this file is only a template) ---
# APP_KEY      generate locally with: php artisan key:generate --show
# APP_URL      MUST be the https public URL, e.g. https://your-app.up.railway.app
#              (it is used to build the callbackUrl sent to Paga)
# DB_*         map to the Railway MySQL service: DB_HOST=${{MySQL.MYSQLHOST}},
#              DB_PORT=${{MySQL.MYSQLPORT}}, DB_DATABASE=${{MySQL.MYSQLDATABASE}},
#              DB_USERNAME=${{MySQL.MYSQLUSER}}, DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}
# REDIS_*      map to the Railway Redis service: REDIS_HOST=${{Redis.REDISHOST}},
#              REDIS_PORT=${{Redis.REDISPORT}}, REDIS_PASSWORD=${{Redis.REDISPASSWORD}}
APP_NAME=RemitRova
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app.up.railway.app

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=remitrova
DB_USERNAME=remitrova
DB_PASSWORD=

QUEUE_CONNECTION=redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

SESSION_DRIVER=redis
CACHE_STORE=redis

PAGA_COLLECT_BASE_URL=https://beta-collect.paga.com
PAGA_PRINCIPAL=
PAGA_SECRET_KEY=
PAGA_HASH_KEY=

PAGA_BUSINESS_BASE_URL=https://beta.mypaga.com/paga-webservices/business-rest/secured

# HitchPay (see App\Services\Payments\HitchPay).
# Get client_id/client_secret from the HitchPay Merchant Dashboard.
HITCHPAY_BASE_URL=https://sandbox.hitchpay.ng
HITCHPAY_CLIENT_ID=
HITCHPAY_CLIENT_SECRET=
# Sandbox only: uuid HitchPay already issued for test@remitrova.com. A fresh
# database would otherwise try to enroll that customer again and get
# DUPLICATE_REQUEST. /dev/seed-test-customer stores it on the test customer.
HITCHPAY_TEST_CUSTOMER_UUID=64064cef-d4be-4464-adf4-533988ce6242

# TEMPORARY — protects the /dev/* routes in routes/web.php. Remove
# along with those routes before production.
DEV_SEED_KEY=
